# Conflict Map Environment Variables

# Backend API URL (local development)
NEXT_PUBLIC_API_URL=http://localhost:8000

# For production Railway backend during development:
# NEXT_PUBLIC_API_URL=https://naija-conflict-tracker-production.up.railway.app

# API Request Timeout (milliseconds)
# Default: 15000 (15 seconds)
# Increase if backend is slow or network is unreliable
NEXT_PUBLIC_REQUEST_TIMEOUT=15000

# Mapbox Access Token (Required for the map)
# Get your token from: https://account.mapbox.com/access-tokens/
NEXT_PUBLIC_MAPBOX_TOKEN=pk.eyJ1IjoibmV4dGllciIsImEiOiJjbTJ1ZGZzNGswMDBzMmlzaGpvN3QybW40In0.placeholder
